generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id         String      @id @default(uuid())
  nome       String
  email      String      @unique
  senha      String
  dataNasc   DateTime    @db.Date
  criadoEm   DateTime    @default(now())
  progressos Progresso[]

  @@map("usuario")
}

model Progresso {
  id           String   @id @default(uuid())
  usuarioId    String
  pilar        String   // "decomposicao" | "abstracao" | "padroes" | "algoritmo"
  nivelAtual   Int      @default(0) // Nível de 0 a 8 onde o usuário está
  rotinaAtual  Int      @default(0) // Rotina 0 ou 1 dentro do nível
  concluido    Boolean  @default(false)
  atualizadoEm DateTime @updatedAt

  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, pilar])
  @@map("progresso")
}
